{
  "realm": "mymusic",
  "displayName": "MyMusic",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "loginTheme": "mymusic",
  "internationalizationEnabled": true,
  "supportedLocales": ["de"],
  "defaultLocale": "de",

  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,

  "roles": {
    "realm": [
      {
        "name": "User",
        "description": "Darf die eigene Sammlung verwalten (CRUD auf eigene Daten)."
      },
      {
        "name": "Admin",
        "description": "Alle Rechte der Rolle User und darf Benutzer inklusive aller Daten loeschen."
      }
    ]
  },

  "clients": [
    {
      "clientId": "mymusic-angular",
      "name": "MyMusic Angular Client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:4200/*"
      ],
      "webOrigins": [
        "http://localhost:4200"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*"
      }
    },
    {
      "clientId": "mymusic-integration-tests",
      "name": "MyMusic Integration Test Client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [],
      "webOrigins": []
    },
    {
      "clientId": "mymusic-admin-service",
      "name": "MyMusic Admin Service Account",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],

  "users": [
    {
      "username": "service-account-mymusic-admin-service",
      "enabled": true,
      "serviceAccountClientId": "mymusic-admin-service",
      "clientRoles": {
        "realm-management": ["view-users", "query-users", "manage-users"]
      }
    }
  ]
}
